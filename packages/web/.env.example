# Copy to .env.local and fill in. Vite only exposes vars prefixed with VITE_.

# Supabase project (Settings -> API). Both values are safe to ship in the
# client bundle: the anon key only permits what RLS + the RPC grants allow.
VITE_SUPABASE_URL=https://skagtaxusihzeiexfjzr.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- NOT for the web app ---
# The service-role key bypasses RLS. Only ever used locally by
# supabase/scripts/bootstrap-super-admin.ts and inside the Edge Function.
# Do not add it here or anywhere in packages/web.
